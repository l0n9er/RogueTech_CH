    {
      "dialogue": {
        "EncounterObjectGuid": "9193a080-418b-4e46-aeb0-f8ac55fb63b5"
      },
      "name": "Dialogue_Interrupt_TurretWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "指挥官，提醒一句，有报告称该基地可能设有定点防御炮位。",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_DariusDefault",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "9a1bfa77-fc82-4e20-be61-63ebe1d1949e",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        },
        {
          "words": "是炮塔，头儿。留神点，以防它们还在运转。",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_DariusDefault",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "37173dfd-65d9-40dc-b498-906086595931"
      },
      "name": "Dialogue_Interrupt_GoToComplete",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "前面就是基地了。看来我们的雇主没有开玩笑；它是空的。",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_DariusDefault",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        },
        {
          "words": "真无聊。无论如何我能不能朝些建筑打几枪？",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_Contract_TrainingDay_2",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        },
        {
          "words": "呃。我侦测到了引擎信号，老大。我猜那些不是友军，他们向着你过来了。",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_SumireDefault",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "1ed1ecd2-449b-4df9-8ab5-29846b40c1ad",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        },
        {
          "words": "引擎？像是机甲引擎？噢该死，噢该死，我不想死--",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_Contract_TrainingDay_5",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        },
        {
          "words": "派你的小队进入那座基地，指挥官，在我们雇主派更多人到地面之前守住。",
          "wordsColor": {
            "r": 1,
            "g": 1,
            "b": 1,
            "a": 1
          },
          "selectedCastDefId": "castDef_DariusDefault",
          "emote": "Default",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1",
          "cameraDistance": "Far",
          "cameraHeight": "Default",
          "revealRadius": -1
        }
      ]
    }
